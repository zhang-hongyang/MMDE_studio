{
    "_comment": "Demo config — single image + sparse depth",

    "model": {
        "encoder": "vitl",
        "checkpoint": "checkpoints/depth_anything_v2_vitl.pth",
        "_comment_checkpoint": "Resolved under third_party/Depth-Anything-V2/checkpoints/",
        "input_size": 518
    },

    "dataset": {
        "type": "demo",
        "image_path": "assets/demo/example/image.jpg",
        "sparse_path": "assets/demo/example/sparse_depth.npy",
        "sparse_format": "mm_uint16",
        "gt_path": ""
    },

    "algorithm": {
        "min_depth": 0.1,
        "max_depth": 15.0,

        "segmentation": {
            "method": "felzenszwalb",
            "_comment_method": "felzenszwalb | fast_slic | opencv_lsc — see doc.md",
            "scale": 1000,
            "sigma": 0.5,
            "min_size": 1000,
            "fast_slic": {
                "num_components": 1600,
                "compactness": 10,
                "use_avx2": true,
                "min_size_factor": 0
            },
            "opencv_lsc": {
                "region_size": 20,
                "ratio": 0.075,
                "iterations": 1
            }
        },

        "segment_fitting": {
            "min_count": 5
        },

        "segment_backend": "torch",

        "use_segment_propagation": true,
        "use_params_propagation": false,
        "propagation": {
            "k_neighbors": 4
        },

        "bilateral_filter": {
            "iterations": 5,
            "spatial_sigma": 1.0,
            "color_sigma": 0.05,
            "kernel_size": 11,
            "use_anchor": false
        },

        "use_dadp": false,
        "dadp_variant": "torch_dadp",
        "dadp": {
            "iterations": 1,
            "seed_energy": -10.0
        }
    },

    "output": {
        "output_dir": "output/demo"
    }
}
